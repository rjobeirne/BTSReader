<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:text=" Bedtime Story Reader "
        android:textSize="24sp"
        android:textColor="@color/white"
        android:background="@color/opaque_teal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <ImageButton
        android:id="@+id/button_settings"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_centerInParent="true"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="8dp"
        android:src="@mipmap/settings"
        app:layout_constraintTop_toBottomOf="@id/title"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:id="@+id/radio"
        android:layout_width="120dp"
        android:layout_height="80dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="32dp"
        android:alpha="0.6"
        android:src="@drawable/radio"
        app:layout_constraintBottom_toTopOf="@+id/current_cover"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title" />

    <Button
        android:id="@+id/play_radio"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:text="Radio"
        android:background="@color/opaque_teal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/radio"
        app:layout_constraintBottom_toBottomOf="@id/radio" />

    <Button
        android:id="@+id/list_books"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Library"
        android:background="@color/opaque_teal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/book_list"
        app:layout_constraintTop_toTopOf="@id/book_list" />

    <Button
        android:id="@+id/list_meditation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Meditation"
        android:background="@color/opaque_teal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/meditation_list"
        app:layout_constraintTop_toTopOf="@id/meditation_list" />

    <Button
        android:id="@+id/continue_listen"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Continue Listening"
        android:background="@color/opaque_teal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/current_cover"
        app:layout_constraintTop_toTopOf="@id/current_cover" />

    <ImageView
        android:id="@+id/current_cover"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginTop="64dp"
        android:layout_marginBottom="32dp"
        android:alpha="0.6"
        app:layout_constraintBottom_toTopOf="@+id/book_list"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.501"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageView
        android:id="@+id/book_list"
        android:layout_width="240dp"
        android:layout_height="132dp"
        android:layout_marginBottom="32dp"
        android:src="@drawable/library"
        android:alpha="0.6"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toTopOf="@id/meditation_list" />

    <ImageView
        android:id="@+id/meditation_list"
        android:layout_width="160dp"
        android:layout_height="132dp"
        android:src="@drawable/meditate_crop"
        android:alpha="0.6"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>